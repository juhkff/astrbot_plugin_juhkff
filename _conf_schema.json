{
  "global": {
    "type": "object",
    "description": "全局设置",
    "hint": "所有功能共用的开关、日志、代理和时区。",
    "items": {
      "enabled": {
        "description": "总开关",
        "type": "bool",
        "default": true,
        "hint": "关闭后停用本插件的所有功能。"
      },
      "debug": {
        "description": "详细日志",
        "type": "bool",
        "default": true,
        "hint": "记录运行细节，方便排查问题。",
        "obvious_hint": true
      },
      "proxy": {
        "description": "网络代理",
        "type": "string",
        "default": "",
        "hint": "网页和图片请求使用的 HTTP 代理，如 http://127.0.0.1:7890；留空不单独设置代理。"
      },
      "timezone": {
        "description": "时区",
        "type": "string",
        "default": "Asia/Shanghai",
        "hint": "用于日报日期和定时任务，如 Asia/Shanghai（北京时间）或 UTC。"
      }
    }
  },
  "share_parse": {
    "type": "object",
    "description": "卡片解析",
    "hint": "自动提取分享卡片的标题、简介和链接，可附带封面；不处理普通文字链接。",
    "items": {
      "enable": {
        "description": "启用",
        "type": "bool",
        "default": true
      },
      "parse_bilibili": {
        "description": "解析 B 站分享",
        "type": "bool",
        "default": true
      },
      "parse_xiaoheihe": {
        "description": "解析小黑盒分享",
        "type": "bool",
        "default": true
      },
      "parse_generic": {
        "description": "解析其他分享卡片",
        "type": "bool",
        "default": true,
        "hint": "解析 B 站、小黑盒之外的分享卡片。"
      },
      "fetch_cover": {
        "description": "附带封面图",
        "type": "bool",
        "default": true,
        "hint": "在解析结果中附上封面；未找到封面时只发文字。"
      },
      "cover_timeout": {
        "description": "封面查询超时（秒）",
        "type": "int",
        "default": 8,
        "slider": {
          "min": 1,
          "max": 30,
          "step": 1
        },
        "hint": "查询 B 站封面或解析短链接时，单次请求最多等待多久。"
      },
      "at_sender": {
        "description": "回复时 @ 发送者",
        "type": "bool",
        "default": false,
        "hint": "在解析回复中 @ 分享卡片的人。"
      }
    }
  },
  "emoji_steal": {
    "type": "object",
    "description": "偷表情",
    "hint": "同群相同图片在指定时长内出现两次后收藏，并按概率随机发送表情。",
    "items": {
      "enable": {
        "description": "启用",
        "type": "bool",
        "default": true
      },
      "size_limit_mb": {
        "description": "收藏图片大小上限（MB）",
        "type": "float",
        "default": 2,
        "hint": "超过此大小的群图片不收藏；不限制本地表情包文件夹。",
        "slider": {
          "min": 0.1,
          "max": 10,
          "step": 0.1
        }
      },
      "judge_emoji": {
        "type": "bool",
        "description": "启用表情包判断",
        "default": true,
        "hint": "开启且选择模型后才判断；非表情不收藏，判断失败仍按重复规则收藏。"
      },
      "judge_provider": {
        "type": "string",
        "description": "表情判断模型",
        "default": "",
        "_special": "select_provider",
        "hint": "选择支持图片输入的模型；留空跳过判断，不使用群聊模型。仅在开启表情判断时生效。"
      },
      "max_per_group": {
        "description": "每群收藏上限（张）",
        "type": "int",
        "default": 30,
        "hint": "新增收藏超出上限时，删除最早收藏的图片；不限制本地表情包文件夹。",
        "slider": {
          "min": 10,
          "max": 100,
          "step": 10
        }
      },
      "default_emoji_rate": {
        "description": "默认发图概率",
        "type": "float",
        "default": 0.2,
        "hint": "每条群消息发图的概率，0.2 表示 20%。优先用本群收藏，无可用收藏时用本地文件夹；0 不发图，仍收藏。",
        "slider": {
          "min": 0,
          "max": 1,
          "step": 0.01
        }
      },
      "gallery_path": {
        "description": "本地表情包文件夹",
        "type": "string",
        "default": "",
        "hint": "本群无可用收藏时使用，支持子文件夹；相对路径从插件数据目录算起。留空停用，文件列表缓存 60 秒。"
      },
      "group_rates": {
        "description": "分群发图概率",
        "type": "template_list",
        "default": [],
        "hint": "为指定群单独设置发图概率；未设置的群用默认值，同群多条规则只用第一条。不影响收藏。",
        "templates": {
          "rule": {
            "name": "分群设置",
            "items": {
              "groups": {
                "description": "适用群",
                "type": "list",
                "default": [],
                "_special": "umo",
                "hint": "选择群聊，可多选，也可填写群号；留空则此规则不生效。"
              },
              "emoji_rate": {
                "name": "发图概率",
                "type": "float",
                "default": 0.2,
                "slider": {
                  "min": 0,
                  "max": 1,
                  "step": 0.01
                },
                "description": "发图概率",
                "hint": "这些群的发图概率，0.2 表示 20%；0 不发图，仍收藏。"
              }
            }
          }
        }
      },
      "expire_hours": {
        "description": "重复图片统计时长（小时）",
        "type": "int",
        "default": 72,
        "slider": {
          "min": 0,
          "max": 336,
          "step": 1
        },
        "hint": "同群相同图片从首次计数起，在此时长内第二次出现即收藏，超时重新计数；0 不过期。此设置不清理已收藏图片。"
      }
    }
  },
  "daily_report": {
    "type": "object",
    "description": "日报",
    "hint": "发送 #日报 获取今日日报，包含时政、国内社会、游戏、数码四类新闻，每类最多 12 条。",
    "items": {
      "enable": {
        "description": "启用",
        "type": "bool",
        "default": true
      },
      "style": {
        "description": "日报风格",
        "type": "string",
        "default": "random",
        "options": [
          "random",
          "crosspoint",
          "nightwire",
          "dayletter",
          "dailydrop",
          "greenfolio"
        ],
        "labels": [
          "随机",
          "1 · 红黑索引",
          "2 · 深色电讯",
          "3 · 纸张手帐",
          "4 · 撞色网格",
          "5 · 青绿四栏"
        ],
        "hint": "随机时每次发送随机选一款，也可固定样式；#日报 和定时推送共用此设置。"
      },
      "push": {
        "description": "定时自动推送",
        "type": "bool",
        "default": true,
        "hint": "每天按下方时间自动发送日报；需先选择推送群，关闭后仍可发送 #日报 获取。"
      },
      "push_group_list": {
        "description": "推送群",
        "type": "list",
        "default": [],
        "hint": "选择自动接收日报的群，可多选；留空不自动推送。",
        "_special": "umo"
      },
      "pre_handle": {
        "description": "提前生成",
        "type": "bool",
        "default": false,
        "hint": "按下方时间提前生成日报，减少发送时的等待；随机样式准备五款，固定样式只准备所选款。"
      },
      "push_hour": {
        "description": "推送时间（时）",
        "type": "int",
        "default": 12,
        "slider": {
          "min": 0,
          "max": 23,
          "step": 1
        },
        "hint": "每天推送的小时，使用全局设置中的时区；需开启定时自动推送并选择群。"
      },
      "push_minute": {
        "description": "推送时间（分）",
        "type": "int",
        "default": 0,
        "slider": {
          "min": 0,
          "max": 59,
          "step": 1
        },
        "hint": "与上方小时组成推送时间，例如 12 时 30 分。"
      },
      "pre_handle_hour": {
        "description": "提前生成时间（时）",
        "type": "int",
        "default": 10,
        "slider": {
          "min": 0,
          "max": 23,
          "step": 1
        },
        "hint": "每天几点提前生成日报，建议设在推送之前；仅开启提前生成时生效。"
      },
      "pre_handle_minute": {
        "description": "提前生成时间（分）",
        "type": "int",
        "default": 0,
        "slider": {
          "min": 0,
          "max": 59,
          "step": 1
        },
        "hint": "与上方小时组成提前生成时间，使用全局设置中的时区。"
      },
      "pre_handle_retry_sec": {
        "description": "提前生成重试间隔（秒）",
        "type": "int",
        "default": 120,
        "slider": {
          "min": 30,
          "max": 600,
          "step": 30
        },
        "hint": "提前生成失败后等待多久再试，最多重试 5 次。"
      }
    }
  },
  "pixiv_push": {
    "type": "object",
    "description": "Pixiv 订阅",
    "hint": "订阅画师新插画，将新作和全部图片合并转发。首次订阅或重启 AstrBot 后，首次检查只记录最新作品，不补推旧作。",
    "items": {
      "enable": {
        "description": "启用",
        "type": "bool",
        "default": true
      },
      "subscriptions": {
        "description": "画师订阅列表",
        "type": "template_list",
        "default": [],
        "hint": "每位画师填写一条，并选择接收群；群内订阅指令会同步到这里。留空不检查、不推送。",
        "templates": {
          "artist": {
            "name": "画师订阅",
            "items": {
              "user_id": {
                "description": "画师 UID",
                "type": "string",
                "default": "",
                "hint": "画师主页中的数字用户 ID，不是作品 ID。"
              },
              "groups": {
                "description": "接收群",
                "type": "list",
                "default": [],
                "hint": "选择接收这位画师新作的群，可多选；不选群则此订阅不生效。",
                "_special": "umo"
              }
            }
          }
        }
      },
      "check_minutes": {
        "description": "检查间隔（分钟）",
        "type": "int",
        "default": 60,
        "hint": "正常情况下，每隔多久检查一次画师新作，发现新作后自动推送。",
        "slider": {
          "min": 1,
          "max": 1440,
          "step": 1
        }
      },
      "retry_interval_minutes": {
        "description": "重试基础间隔（分钟）",
        "type": "int",
        "default": 2,
        "hint": "获取作品、下载或发送失败后的首次等待时间。设为 2 时，连续失败依次等 2、4、6…分钟；成功后恢复正常检查。",
        "slider": {
          "min": 1,
          "max": 1440,
          "step": 1
        }
      },
      "max_image_mb": {
        "description": "图片压缩阈值（MB）",
        "type": "float",
        "default": 0.0,
        "hint": "0 表示不压缩；大于 0 时仅压缩超过此大小的图片。始终优先下载原图。",
        "slider": {
          "min": 0,
          "max": 30,
          "step": 0.5
        }
      }
    }
  },
  "help": {
    "type": "object",
    "description": "帮助图",
    "hint": "发送帮助指令，查看本插件已启用功能的用法；默认指令为 #帮助。",
    "items": {
      "enable": {
        "description": "启用",
        "type": "bool",
        "default": true
      },
      "command": {
        "description": "触发指令",
        "type": "string",
        "default": "帮助",
        "hint": "只填指令名称，不加 # 或 /；例如填“帮助”，群里发送 #帮助。"
      },
      "title_zh": {
        "description": "中文标题",
        "type": "string",
        "default": "",
        "hint": "帮助内容的标题；留空使用指令名称，例如“帮助”。"
      },
      "title_en": {
        "description": "英文标题",
        "type": "string",
        "default": "JUHKFF-PLUGIN",
        "hint": "显示在帮助图顶部；留空使用 JUHKFF-PLUGIN。"
      },
      "render_image": {
        "description": "以图片发送帮助",
        "type": "bool",
        "default": true,
        "hint": "开启发送图片，关闭发送文字。"
      }
    }
  }
}
