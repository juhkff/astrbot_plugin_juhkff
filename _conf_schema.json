{
  "global": {
    "type": "object",
    "description": "全局设置",
    "hint": "总开关、代理、时区等所有功能共用的配置",
    "items": {
      "enabled": {
        "description": "总开关",
        "type": "bool",
        "default": true,
        "hint": "关掉后这个插件的所有功能都停用"
      },
      "debug": {
        "description": "详细日志",
        "type": "bool",
        "default": false,
        "hint": "打开后会把内部细节写进日志（连接情况、抓取失败原因等），主动群聊还会打印每次发给模型的内容，含聊天原文，排查完记得关",
        "obvious_hint": true
      },
      "proxy": {
        "description": "网络代理",
        "type": "string",
        "default": "",
        "hint": "形如 http://127.0.0.1:7890 或 socks5://127.0.0.1:1080；留空表示直连（抓网页和图片时用）"
      },
      "timezone": {
        "description": "时区",
        "type": "string",
        "default": "Asia/Shanghai",
        "hint": "例如 Asia/Shanghai（北京时间）、UTC；填错会按服务器本地时区算"
      }
    }
  },
  "active_chat": {
    "type": "object",
    "description": "主动群聊",
    "hint": "在群里有概率主动插话。配置项与上游 autoReply 一致：没有冷却、没有最小消息数，只有概率和 @ 必回",
    "items": {
      "enable": {
        "description": "启用",
        "type": "bool",
        "default": false
      },
      "provider": {
        "description": "对话模型",
        "type": "string",
        "default": "",
        "_special": "select_provider",
        "hint": "留空就用这个群当前绑定的对话模型；群没绑定时用 AstrBot 里第一个可用的对话模型"
      },
      "default_chat_rate": {
        "description": "默认接话概率",
        "type": "float",
        "default": 0.1,
        "slider": {
          "min": 0,
          "max": 1,
          "step": 0.05
        },
        "hint": "没被 @ 也没被引用时，按这个概率决定要不要接话"
      },
      "default_reply_at_bot": {
        "description": "被 @ 或引用时必回",
        "type": "bool",
        "default": true,
        "hint": "以 / 或 # 开头的指令消息不算在内，不会被当成在叫它"
      },
      "group_chat_rate": {
        "description": "按群覆盖概率",
        "type": "template_list",
        "hint": "这里列出的群用下面的概率，没列出的群用默认值",
        "templates": {
          "rule": {
            "name": "分群设置",
            "items": {
              "group_list": {
                "description": "群",
                "type": "list",
                "default": [],
                "hint": "点右侧图标搜索群名选择（可多选）；也可以直接填群号",
                "_special": "umo"
              },
              "chat_rate": {
                "description": "接话概率",
                "type": "float",
                "default": 0.1,
                "slider": {
                  "min": 0,
                  "max": 1,
                  "step": 0.05
                }
              },
              "reply_at_bot": {
                "description": "被 @ 或引用时必回",
                "type": "bool",
                "default": true
              }
            }
          }
        }
      },
      "use_context": {
        "description": "携带聊天上下文",
        "type": "bool",
        "default": true,
        "hint": "关掉后每次只发当前这条消息，不带任何历史（相当于每轮失忆）"
      },
      "max_history_length": {
        "description": "上下文条数",
        "type": "int",
        "default": 5,
        "hint": "带多少条历史给模型；0 = 只发当前这条",
        "slider": {
          "min": 0,
          "max": 64,
          "step": 1
        }
      },
      "history_ttl_hours": {
        "description": "历史保留时长（小时）",
        "type": "int",
        "default": 12,
        "slider": {
          "min": 0,
          "max": 168,
          "step": 1
        },
        "hint": "最后一条消息之后过这么久，整段历史自动清掉；0 = 一直保留"
      },
      "redis_url": {
        "description": "历史存储（Redis 地址）",
        "type": "string",
        "default": "redis://127.0.0.1:6379/0",
        "hint": "留空或连不上就没有跨重启的上下文；有密码时写成 redis://:密码@127.0.0.1:6379/0"
      },
      "redis_key_prefix": {
        "description": "数据前缀",
        "type": "string",
        "default": "juhkff:active_chat",
        "hint": "多个机器人共用同一个 Redis 时用不同前缀隔开，一般不用改"
      },
      "clear_history_on_start": {
        "description": "启动时清空历史聊天数据",
        "type": "bool",
        "default": true,
        "hint": "重启机器人时清空历史（WebUI 里保存配置触发的热重载不会清）；关掉则重启后继续用旧上下文"
      },
      "attach_url_analysis": {
        "description": "附带链接内容",
        "type": "bool",
        "default": false,
        "hint": "先抓消息里链接的正文，再让模型接话"
      },
      "url_content_chars": {
        "description": "链接正文长度（字）",
        "type": "int",
        "default": 400,
        "slider": {
          "min": 100,
          "max": 2000,
          "step": 100
        },
        "hint": "每个链接最多带多少字正文；只作为独立参考消息交给模型，不拼进群友原话"
      },
      "persona_prompt": {
        "description": "人设提示词",
        "type": "text",
        "editor_mode": true,
        "editor_language": "markdown",
        "default": "你在一个QQ群聊里，扮演一名普通群员参与聊天。\n只输出一条要发到群里的消息：不要用括号写动作或旁白，不要换行，不要以「回复xx」开头，句尾不加标点；不要解释思路，也不要带日期和昵称。\n你在群里的昵称是{{botName}}。\n\n请像普通群员那样接着最新这条说一句话，只输出要发的内容本身。\n更早的消息只是聊天背景：不要回复它们，不要续写它们，也不要复述里面的「当时」之类标记。",
        "hint": "发给模型的设定，改完保存即生效；可用 {{botName}} 代表机器人昵称；点右上角按钮可全屏编辑"
      }
    }
  },
  "share_parse": {
    "type": "object",
    "description": "卡片解析",
    "hint": "识别 B 站、小黑盒等分享卡片，补上标题、作者、封面",
    "items": {
      "enable": {
        "description": "启用",
        "type": "bool",
        "default": false
      },
      "parse_bilibili": {
        "description": "解析 B 站分享",
        "type": "bool",
        "default": true
      },
      "parse_xiaoheihe": {
        "description": "解析小黑盒分享",
        "type": "bool",
        "default": true
      },
      "parse_generic": {
        "description": "解析通用链接",
        "type": "bool",
        "default": true,
        "hint": "关闭后只认 B 站和小黑盒；其它卡片会被忽略"
      },
      "fetch_cover": {
        "description": "附带封面图",
        "type": "bool",
        "default": true,
        "hint": "B 站封面要额外请求一次 b23 短链和番剧接口，失败不影响文字解析"
      },
      "cover_timeout": {
        "description": "封面抓取超时（秒）",
        "type": "int",
        "default": 8,
        "slider": {
          "min": 1,
          "max": 30,
          "step": 1
        },
        "hint": "抓封面 / 解析短链的超时秒数"
      },
      "at_sender": {
        "description": "回复时 @ 发送者",
        "type": "bool",
        "default": false,
        "hint": "解析结果里带一下是谁发的"
      }
    }
  },
  "emoji_steal": {
    "type": "object",
    "description": "偷表情",
    "hint": "同一张图被群友反复发送就收进表情库",
    "items": {
      "enable": {
        "description": "启用",
        "type": "bool",
        "default": false
      },
      "size_limit_kb": {
        "description": "单张大小上限（KB）",
        "type": "int",
        "default": 100,
        "hint": "超过这个大小的图不收藏；1024 = 1MB",
        "slider": {
          "min": 10,
          "max": 1024,
          "step": 10
        }
      },
      "judge_emoji": {
        "type": "bool",
        "description": "启用表情包判断",
        "default": false,
        "hint": "开启后每张图第一次出现时交给模型判断是不是表情包；不是则不计数、不收藏，已计过的计数会被清掉。判断不了（模型报错）时按原逻辑处理"
      },
      "judge_provider": {
        "type": "string",
        "description": "表情判断用的模型",
        "default": "",
        "_special": "select_provider",
        "hint": "留空则用当前会话的对话模型；只有启用表情包判断时才生效"
      },
      "max_per_group": {
        "description": "每群最多收藏",
        "type": "int",
        "default": 50,
        "hint": "每个群最多存多少张，超出按收藏时间淘汰最旧的",
        "slider": {
          "min": 10,
          "max": 500,
          "step": 10
        }
      },
      "default_reply_rate": {
        "description": "默认接话概率",
        "type": "float",
        "default": 0.1,
        "slider": {
          "min": 0,
          "max": 1,
          "step": 0.01
        },
        "hint": "收到群消息时，按这个概率决定要不要接话"
      },
      "default_emoji_rate": {
        "description": "默认发图概率",
        "type": "float",
        "default": 0.2,
        "hint": "接话命中后，再按这个概率决定发图还是不发",
        "slider": {
          "min": 0,
          "max": 1,
          "step": 0.01
        }
      },
      "group_rates": {
        "description": "按群覆盖概率",
        "type": "template_list",
        "default": [],
        "hint": "这里列出的群用下面的概率，没列出的群用默认值",
        "templates": {
          "rule": {
            "name": "分群设置",
            "items": {
              "groups": {
                "description": "群",
                "type": "list",
                "default": [],
                "_special": "umo",
                "hint": "点右侧图标搜索群名选择（可多选）；也可以直接填群号"
              },
              "reply_rate": {
                "name": "接话概率",
                "type": "float",
                "default": 0.1,
                "slider": {
                  "min": 0,
                  "max": 1,
                  "step": 0.01
                },
                "description": "接话概率"
              },
              "emoji_rate": {
                "name": "发图概率",
                "type": "float",
                "default": 0.2,
                "slider": {
                  "min": 0,
                  "max": 1,
                  "step": 0.01
                },
                "description": "发图概率"
              }
            }
          }
        }
      },
      "expire_hours": {
        "description": "表情判定窗口（小时）",
        "type": "int",
        "default": 72,
        "slider": {
          "min": 0,
          "max": 720,
          "step": 1
        },
        "hint": "同一张图在窗口内被同群发第二次才收藏；0 = 永不过期"
      }
    }
  },
  "daily_report": {
    "type": "object",
    "description": "日报",
    "hint": "对齐上游 dailyReport：一言、60 秒读世界、B 站热搜、IT 之家、番剧日历，渲染成一张卡片",
    "items": {
      "enable": {
        "description": "启用",
        "type": "bool",
        "default": false
      },
      "alapi_token": {
        "description": "ALAPI 令牌",
        "type": "string",
        "default": "",
        "secret": true,
        "hint": "用于抓「60 秒读世界」；留空就用免费的公开接口。到 alapi.cn 注册可申请"
      },
      "daily_report_full_show": {
        "description": "显示完整新闻列表",
        "type": "bool",
        "default": true,
        "hint": "关掉只显示前 3 条"
      },
      "push": {
        "description": "定时自动推送",
        "type": "bool",
        "default": false,
        "hint": "打开后每天在下面设的时间推送到群"
      },
      "push_group_list": {
        "description": "推送群",
        "type": "list",
        "default": [],
        "hint": "从已有群聊里选，可多选；留空则只响应 #日报、不自动推送",
        "_special": "umo"
      },
      "pre_handle": {
        "description": "提前生成",
        "type": "bool",
        "default": false,
        "hint": "推送前先生成好图片并缓存，推送时直接发"
      },
      "push_hour": {
        "description": "推送时间（时）",
        "type": "int",
        "default": 12,
        "slider": {
          "min": 0,
          "max": 23,
          "step": 1
        },
        "hint": "每天几点推送，按上面的时区算"
      },
      "push_minute": {
        "description": "推送时间（分）",
        "type": "int",
        "default": 0,
        "slider": {
          "min": 0,
          "max": 59,
          "step": 1
        }
      },
      "pre_handle_hour": {
        "description": "提前生成（时）",
        "type": "int",
        "default": 10,
        "slider": {
          "min": 0,
          "max": 23,
          "step": 1
        },
        "hint": "提前生成开始的时间，一般比推送早 1~2 小时"
      },
      "pre_handle_minute": {
        "description": "提前生成（分）",
        "type": "int",
        "default": 0,
        "slider": {
          "min": 0,
          "max": 59,
          "step": 1
        }
      }
    }
  },
  "pixiv_push": {
    "type": "object",
    "description": "Pixiv 订阅",
    "hint": "定时抓取 Pixiv 榜单新图并推送到指定群",
    "items": {
      "enable": {
        "description": "启用",
        "type": "bool",
        "default": false
      },
      "targets": {
        "description": "推送群",
        "type": "list",
        "default": [],
        "hint": "从已有群聊里选；留空则只记录、不推送",
        "_special": "umo"
      },
      "check_minutes": {
        "description": "检查间隔（分钟）",
        "type": "int",
        "default": 60,
        "hint": "最勤快的轮询间隔；Pixiv 有游客限流，别低于 30",
        "slider": {
          "min": 10,
          "max": 1440,
          "step": 10
        }
      },
      "ranking_mode": {
        "description": "榜单",
        "type": "string",
        "default": "day",
        "options": [
          "day",
          "week",
          "month"
        ],
        "hint": "日榜 / 周榜 / 月榜",
        "labels": [
          "日榜",
          "周榜",
          "月榜"
        ]
      },
      "max_push_per_run": {
        "description": "单次最多推送几个作品",
        "type": "int",
        "default": 2,
        "slider": {
          "min": 1,
          "max": 10,
          "step": 1
        }
      },
      "max_image_mb": {
        "description": "图片大小上限（MB）",
        "type": "float",
        "default": 8.0,
        "hint": "超过则压缩，压缩失败只发文字",
        "slider": {
          "min": 1,
          "max": 30,
          "step": 0.5
        }
      }
    }
  },
  "help": {
    "type": "object",
    "description": "帮助图",
    "hint": "发送 #帮助 查看本插件全部功能",
    "items": {
      "enable": {
        "description": "启用",
        "type": "bool",
        "default": true
      },
      "command": {
        "description": "触发指令",
        "type": "string",
        "default": "帮助",
        "hint": "触发词本身，不要带前缀；默认「帮助」= 群里发 #帮助 或 /帮助"
      },
      "title_zh": {
        "description": "图片中文标题",
        "type": "string",
        "default": "",
        "hint": "留空则用触发词（帮助）"
      },
      "title_en": {
        "description": "图片英文标题",
        "type": "string",
        "default": "JUHKFF-PLUGIN"
      },
      "render_image": {
        "description": "渲染为图片",
        "type": "bool",
        "default": true,
        "hint": "关闭后输出纯文本；图片走 AstrBot 的 HTML 渲染"
      }
    }
  }
}
