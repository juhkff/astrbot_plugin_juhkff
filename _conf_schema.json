{
  "global": {
    "type": "object",
    "collapsed": true,
    "description": "全局设置",
    "hint": "所有功能共用的开关、代理和时区。",
    "items": {
      "enabled": {
        "description": "总开关",
        "type": "bool",
        "default": true,
        "hint": "关闭后停用本插件的所有功能。"
      },
      "proxy": {
        "description": "网络代理",
        "type": "string",
        "default": "",
        "hint": "网页和图片请求使用的 HTTP 代理，如 http://127.0.0.1:7890；留空不单独设置代理。"
      },
      "timezone": {
        "description": "时区",
        "type": "string",
        "default": "Asia/Shanghai",
        "hint": "用于日报日期和定时任务，如 Asia/Shanghai（北京时间）或 UTC。"
      }
    }
  },
  "group_chat": {
    "type": "object",
    "collapsed": true,
    "description": "主动群聊",
    "hint": "可替代官方 astrbot 群聊触发，复用框架模型、人格与工具；Redis 历史重启保留。",
    "items": {
      "print_log": {
        "description": "打印日志",
        "type": "bool",
        "default": true,
        "hint": "打印本模块的运行日志；关闭后不输出任何级别的日志。"
      },
      "enable": {
        "type": "bool",
        "description": "启用",
        "default": false,
        "hint": "禁用官方 astrbot 后，由本模块负责指定群的主动回复与上下文。"
      },
      "groups": {
        "type": "list",
        "description": "生效群列表",
        "default": [],
        "_special": "umo",
        "hint": "选择群聊，可多选，也可手动填写群号；留空应用于所有群，不影响私聊。"
      },
      "context_messages": {
        "type": "int",
        "description": "近期上下文条数",
        "default": 40,
        "slider": {
          "min": 1,
          "max": 100,
          "step": 1
        },
        "hint": "保留最近消息及回复，超量删最旧；原文和图片描述各限 2000 字符，图片数据不截断。历史不过期，重启保留。"
      },
      "redis_url": {
        "type": "string",
        "description": "Redis 连接地址",
        "default": "redis://localhost:6379/0",
        "hint": "需自备 Redis，支持 redis://:密码@主机:端口/数据库 及 rediss://；连接失败无历史回退。"
      },
      "redis_prefix": {
        "type": "string",
        "description": "Redis 键前缀",
        "default": "astrbot:juhkff:group_chat",
        "hint": "历史存于此前缀，重置仅清理当前会话；多实例请用不同前缀。"
      },
      "probability": {
        "type": "float",
        "description": "普通消息接话概率",
        "default": 0.2,
        "slider": {
          "min": 0,
          "max": 1,
          "step": 0.01
        },
        "hint": "无分群设置时使用，每条独立抽取，无冷却；0 停用随机接话，仍响应唤醒和转述图片。"
      },
      "group_rates": {
        "description": "分群接话概率",
        "type": "template_list",
        "default": [],
        "hint": "覆盖指定群概率，同群仅首条生效；未匹配沿用默认值，不扩大生效群范围。",
        "templates": {
          "rule": {
            "name": "分群设置",
            "items": {
              "groups": {
                "description": "适用群",
                "type": "list",
                "default": [],
                "_special": "umo",
                "hint": "选择群聊，可多选，也可填写群号或完整会话 ID；留空则此规则不生效。"
              },
              "probability": {
                "description": "接话概率",
                "type": "float",
                "default": 0.2,
                "slider": {
                  "min": 0,
                  "max": 1,
                  "step": 0.01
                },
                "hint": "0.2 表示 20%；0 关闭随机接话，不影响 @ 等唤醒回复及文字模式图片转述。"
              }
            }
          }
        }
      },
      "image_mode": {
        "type": "string",
        "description": "群聊图片模式",
        "default": "original",
        "options": [
          "original",
          "caption"
        ],
        "labels": [
          "原图模式",
          "文字模式"
        ],
        "hint": "原图模式需视觉模型；文字模式先转成描述。均保留原图及历史图片。"
      },
      "caption_settings": {
        "type": "object",
        "description": "文字模式设置",
        "condition": {
          "image_mode": "caption"
        },
        "items": {
          "provider_id": {
            "type": "string",
            "description": "图片转述模型",
            "default": "",
            "_special": "select_provider",
            "hint": "需支持图片；留空用默认转述或当前聊天模型。每条图片均转述，不受接话概率影响。"
          },
          "detect_meme": {
            "type": "bool",
            "description": "判断是否为表情包",
            "default": true,
            "hint": "开启时识别表情包情绪或梗，关闭时仅描述内容；不影响偷表情。"
          }
        }
      },
      "model": {
        "type": "object",
        "description": "模型与人格",
        "items": {
          "provider_id": {
            "description": "对话模型",
            "type": "string",
            "_special": "select_provider",
            "hint": "留空时使用第一个模型",
            "default": ""
          },
          "fallback_provider_ids": {
            "description": "回退对话模型",
            "type": "list",
            "items": {
              "type": "string"
            },
            "_special": "select_providers",
            "hint": "主聊天模型请求失败时，按顺序切换到这些模型。",
            "default": []
          },
          "request_max_retries": {
            "description": "异常重试次数",
            "type": "int",
            "hint": "单次模型请求遇到可重试错误时的最大尝试次数。",
            "default": 5
          },
          "persona_id": {
            "description": "默认采用的人格",
            "type": "string",
            "_special": "select_persona",
            "default": "default"
          },
          "safety_mode": {
            "description": "健康模式",
            "type": "bool",
            "hint": "引导模型输出健康、安全的内容，避免有害或敏感话题。",
            "default": true
          },
          "safety_mode_strategy": {
            "description": "健康模式策略",
            "type": "string",
            "invisible": true,
            "options": [
              "system_prompt"
            ],
            "hint": "选择健康模式的实现策略。",
            "condition": {
              "safety_mode": true
            },
            "default": "system_prompt"
          }
        }
      },
      "search": {
        "type": "object",
        "description": "联网搜索",
        "items": {
          "web_search": {
            "description": "启用网页搜索",
            "type": "bool",
            "default": false
          },
          "websearch_provider": {
            "description": "网页搜索提供商",
            "type": "string",
            "options": [
              "serpapi",
              "deepseek",
              "tavily",
              "baidu_ai_search",
              "bocha",
              "brave",
              "firecrawl",
              "exa",
              "anysearch"
            ],
            "labels": [
              "SerpApi",
              "DeepSeek Search API",
              "Tavily",
              "Baidu AI Search",
              "Bocha",
              "Brave",
              "Firecrawl",
              "Exa",
              "AnySearch"
            ],
            "subtitles": [
              "Google 网页、新闻、图片、学术和财经搜索",
              "DeepSeek 官方搜索接口",
              "",
              "",
              "",
              "",
              "",
              "",
              ""
            ],
            "condition": {
              "web_search": true
            },
            "default": "tavily"
