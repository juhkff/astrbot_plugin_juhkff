            "type": "list",
            "items": {
              "type": "string"
            },
            "hint": "多 Key 轮询；留空用每日免费匿名额度。申请：https://anysearch.com/console/api-keys",
            "condition": {
              "websearch_provider": "anysearch",
              "web_search": true
            },
            "default": [],
            "secret": true
          },
          "websearch_deepseek_key": {
            "description": "DeepSeek API Key",
            "type": "list",
            "items": {
              "type": "string"
            },
            "hint": "搜索及网页提取用，多 Key 轮询；申请：https://platform.deepseek.com/api_keys",
            "secret": true,
            "condition": {
              "websearch_provider": "deepseek",
              "web_search": true
            },
            "default": []
          },
          "websearch_serpapi_key": {
            "description": "SerpApi API Key",
            "type": "list",
            "items": {
              "type": "string"
            },
            "hint": "多 Key 轮询；申请：https://serpapi.com/manage-api-key",
            "secret": true,
            "condition": {
              "websearch_provider": "serpapi",
              "web_search": true
            },
            "default": []
          },
          "web_search_link": {
            "description": "显示来源引用",
            "type": "bool",
            "condition": {
              "web_search": true
            },
            "default": false
          }
        }
      },
      "reply": {
        "type": "object",
        "description": "回复展示",
        "items": {
          "streaming_response": {
            "description": "流式输出",
            "hint": "在受支持的聊天平台中以打字机的形式输出响应。",
            "type": "bool",
            "default": false
          },
          "display_reasoning_text": {
            "description": "显示思考内容",
            "hint": "显示模型的思维链信息到最终回复中。",
            "type": "bool",
            "default": false
          },
          "show_tool_use_status": {
            "description": "输出工具调用信息",
            "hint": "有工具调用时，同时发送带有工具调用名字的消息。",
            "type": "bool",
            "default": false
          },
          "show_tool_call_result": {
            "description": "输出工具调用结果",
            "type": "bool",
            "hint": "仅在输出工具调用信息启用时生效，展示结果前 70 个字符。",
            "condition": {
              "show_tool_use_status": true
            },
            "default": false
          },
          "buffer_intermediate_messages": {
            "description": "合并 Agent 中间消息",
            "type": "bool",
            "hint": "非流式模式下，工具调用的中间文本在任务完成后合并发送。",
            "condition": {
              "streaming_response": false
            },
            "default": false
          }
        }
      },
      "tools": {
        "type": "object",
        "description": "工具调用",
        "items": {
          "max_steps": {
            "description": "工具调用轮数上限",
            "type": "int",
            "default": 128
          },
          "tool_schema_mode": {
            "description": "工具调用模式",
            "type": "string",
            "options": [
              "skills_like",
              "full"
            ],
            "labels": [
              "Skills-like（两阶段）",
              "Full（完整参数）"
            ],
            "hint": "skills-like 分两步下发名称描述与参数；full 一次下发完整参数。",
            "default": "full"
          },
          "tool_call_timeout": {
            "description": "工具调用超时时间（秒）",
            "type": "int",
            "default": 120
          },
          "sanitize_context_by_modalities": {
            "description": "按模型能力清理历史上下文",
            "type": "bool",
            "hint": "请求前移除当前模型不支持的图片或工具调用结构，会改变模型看到的历史。",
            "default": false
          },
          "add_cron_tools": {
            "description": "启用定时任务工具",
            "type": "bool",
            "hint": "允许模型创建定时任务，在指定时间自动执行。",
            "default": true
          }
        }
      },
      "knowledge": {
        "type": "object",
        "description": "知识库",
        "items": {
          "kb_names": {
            "description": "知识库列表",
            "type": "list",
            "items": {
              "type": "string"
            },
            "_special": "select_knowledgebase",
            "hint": "支持多选",
            "default": []
          },
          "kb_fusion_top_k": {
            "description": "融合检索结果数",
            "type": "int",
            "hint": "多个知识库检索结果融合后的返回结果数量",
            "default": 20
          },
          "kb_final_top_k": {
            "description": "最终返回结果数",
            "type": "int",
            "hint": "最终保留的检索条数；越大信息越多，也可能增加噪音。",
            "default": 5
          },
          "kb_agentic_mode": {
            "description": "Agentic 知识库检索",
            "type": "bool",
            "hint": "由模型自主调用知识库检索工具，需支持函数调用。",
            "default": false
          }
        }
      },
      "input": {
        "type": "object",
        "description": "输入与附件",
        "items": {
          "identifier": {
            "description": "用户识别",
            "type": "bool",
            "hint": "在用户提示词前带上用户 ID 信息。",
            "default": false
          },
          "group_name_display": {
            "description": "显示群名称",
            "type": "bool",
            "hint": "在受支持的消息平台的群聊中的用户提示词前带上群名称信息。",
            "default": false
          },
          "datetime_system_prompt": {
            "description": "现实世界时间感知",
            "type": "bool",
            "hint": "在用户提示词中带上当前的时间信息。",
            "default": true
          },
          "prompt_prefix": {
            "description": "用户提示词",
            "type": "string",
            "hint": "用 {{prompt}} 代表用户输入；不含占位符时添加到输入前。",
            "collapsed": true,
            "default": "{{prompt}}"
          },
          "max_quoted_fallback_images": {
            "description": "引用图片回退解析上限",
            "type": "int",
            "hint": "引用/转发消息回退解析图片时的最大注入数量，超出会截断。",
            "collapsed": true,
            "default": 20
          },
          "max_component_chain_depth": {
            "description": "引用组件链深度",
            "type": "int",
            "hint": "解析 Reply 组件链时允许的最大递归深度。",
            "collapsed": true,
            "default": 4
          },
          "max_forward_node_depth": {
            "description": "转发节点解析深度",
            "type": "int",
            "hint": "解析合并转发节点时允许的最大递归深度。",
            "collapsed": true,
            "default": 6
          },
          "max_forward_fetch": {
            "description": "引用解析转发拉取上限",
            "type": "int",
            "hint": "递归拉取 get_forward_msg 的最大次数。",
            "collapsed": true,
            "default": 32
          },
          "warn_on_action_failure": {
            "description": "引用解析 action 失败告警",
            "type": "bool",
            "hint": "get_msg/get_forward_msg 均失败时记录警告。",
            "collapsed": true,
            "default": false
          },
          "file_extract_enabled": {
            "description": "启用文件解析",
            "type": "bool",
            "default": false
          },
          "file_extract_provider": {
            "description": "文件解析提供商",
            "type": "string",
            "options": [
              "moonshotai"
            ],
            "condition": {
              "file_extract_enabled": true
            },
            "default": "moonshotai"
          },
          "file_extract_api_key": {
            "description": "Moonshot AI API Key",
            "type": "string",
            "secret": true,
            "condition": {
              "file_extract_enabled": true,
              "file_extract_provider": "moonshotai"
            },
            "default": ""
          },
          "image_max_size": {
            "description": "输入图片最大边长",
            "type": "int",
            "hint": "发送给模型的图片最长边（像素），系统会在必要时进一步压缩。",
            "slider": {
              "min": 256,
              "max": 4096,
              "step": 64
            },
            "default": 1280
          }
        }
      },
      "image_caption_provider_id": {
        "type": "string",
        "description": "旧版图片转述模型（兼容配置）",
        "default": "",
        "invisible": true
      },
      "framework": {
        "type": "dict",
        "description": "旧版运行设置（自动迁移）",
        "default": {},
        "invisible": true
      }
    }
  },
  "share_parse": {
    "type": "object",
    "collapsed": true,
    "description": "卡片解析",
    "hint": "自动提取分享卡片的标题、简介和链接，可附带封面；不处理普通文字链接。",
    "items": {
      "print_log": {
        "description": "打印日志",
        "type": "bool",
        "default": true,
        "hint": "打印本模块的运行日志；关闭后不输出任何级别的日志。"
      },
      "enable": {
        "description": "启用",
        "type": "bool",
        "default": true
      },
      "parse_bilibili": {
        "description": "解析 B 站分享",
        "type": "bool",
        "default": true
      },
      "parse_xiaoheihe": {
        "description": "解析小黑盒分享",
        "type": "bool",
        "default": true
      },
      "parse_generic": {
        "description": "解析其他分享卡片",
        "type": "bool",
        "default": true,
        "hint": "解析 B 站、小黑盒之外的分享卡片。"
      },
      "fetch_cover": {
        "description": "附带封面图",
        "type": "bool",
        "default": true,
        "hint": "在解析结果中附上封面；未找到封面时只发文字。"
      },
      "cover_timeout": {
        "description": "封面查询超时（秒）",
        "type": "int",
        "default": 8,
        "slider": {
          "min": 1,
          "max": 30,
          "step": 1
        },
        "hint": "查询 B 站封面或解析短链接时，单次请求最多等待多久。"
      },
      "at_sender": {
        "description": "回复时 @ 发送者",
        "type": "bool",
        "default": false,
        "hint": "在解析回复中 @ 分享卡片的人。"
      }
    }
  },
  "emoji_steal": {
    "type": "object",
    "collapsed": true,
    "description": "偷表情",
    "hint": "同群相同图片在指定时长内出现两次后收藏，并按概率随机发送表情。",
    "items": {
      "print_log": {
        "description": "打印日志",
        "type": "bool",
        "default": true,
        "hint": "打印本模块的运行日志；关闭后不输出任何级别的日志。"
      },
      "enable": {
        "description": "启用",
        "type": "bool",
        "default": true
