{
  "global": {
    "type": "object",
    "description": "全局设置",
    "hint": "所有功能共用的开关、日志、代理和时区。",
    "items": {
      "enabled": {
        "description": "总开关",
        "type": "bool",
        "default": true,
        "hint": "关闭后停用本插件的所有功能。"
      },
      "debug": {
        "description": "详细日志",
        "type": "bool",
        "default": true,
        "hint": "记录运行细节，方便排查问题；主动群聊日志会包含聊天原文和发给模型的内容。",
        "obvious_hint": true
      },
      "proxy": {
        "description": "网络代理",
        "type": "string",
        "default": "",
        "hint": "网页和图片请求使用的 HTTP 代理，如 http://127.0.0.1:7890；留空不单独设置代理。"
      },
      "timezone": {
        "description": "时区",
        "type": "string",
        "default": "Asia/Shanghai",
        "hint": "用于日报日期和定时任务，如 Asia/Shanghai（北京时间）或 UTC。"
      }
    }
  },
  "active_chat": {
    "type": "object",
    "description": "主动群聊",
    "hint": "在群聊中按概率接话，也可设置被 @ 或引用时必回；指令消息不触发接话。",
    "items": {
      "enable": {
        "description": "启用",
        "type": "bool",
        "default": true
      },
      "provider": {
        "description": "对话模型",
        "type": "string",
        "default": "",
        "_special": "select_provider",
        "hint": "留空使用 AstrBot 为当前群选择的对话模型。"
      },
      "default_chat_rate": {
        "description": "默认接话概率",
        "type": "float",
        "default": 0.2,
        "slider": {
          "min": 0,
          "max": 1,
          "step": 0.05
        },
        "hint": "0.2 表示 20%；0 关闭随机接话，不影响已开启的 @ 必回。"
      },
      "default_reply_at_bot": {
        "description": "被 @ 或引用时必回",
        "type": "bool",
        "default": true,
        "hint": "被 @ 或引用机器人消息时直接接话；关闭后仍按概率，指令除外。"
      },
      "send_delay": {
        "description": "延迟发送时间",
        "type": "object",
        "hint": "回复生成后，在范围内随机等待再发送，单位为秒；两项均为 0 时立即发送，顺序填反时自动交换。",
        "items": {
          "min_seconds": {
            "description": "最短时间（秒）",
            "type": "float",
            "default": 1.0,
            "hint": "非负数，支持小数。"
          },
          "max_seconds": {
            "description": "最长时间（秒）",
            "type": "float",
            "default": 3.0,
            "hint": "非负数；与最短时间相同则固定等待此时长。"
          }
        }
      },
      "group_chat_rate": {
        "description": "分群接话设置",
        "type": "template_list",
        "hint": "为指定群单独设置接话概率和 @ 必回；未设置的群使用默认值，同群多条规则只用第一条。",
        "templates": {
          "rule": {
            "name": "分群设置",
            "items": {
              "group_list": {
                "description": "适用群",
                "type": "list",
                "default": [],
                "hint": "选择群聊，可多选，也可填写群号；留空则此规则不生效。",
                "_special": "umo"
              },
              "chat_rate": {
                "description": "接话概率",
                "type": "float",
                "default": 0.2,
                "slider": {
                  "min": 0,
                  "max": 1,
                  "step": 0.05
                },
                "hint": "这些群的随机接话概率，0.2 表示 20%；0 不影响已开启的 @ 必回。"
              },
              "reply_at_bot": {
                "description": "被 @ 或引用时必回",
                "type": "bool",
                "default": true,
                "hint": "这些群被 @ 或引用时是否直接接话；关闭后仍按本条规则的概率。"
              }
            }
          }
        }
      },
      "use_context": {
        "description": "携带聊天上下文",
        "type": "bool",
        "default": true,
        "hint": "是否把聊天历史交给模型；关闭后仍会记录新消息。"
      },
      "max_history_length": {
        "description": "携带的历史条数",
        "type": "int",
        "default": 20,
        "hint": "最多给模型多少条聊天历史，含机器人回复，不含当前消息；0 不带历史。最多保存最近 64 条。",
        "slider": {
          "min": 0,
          "max": 64,
          "step": 1
        }
      },
      "history_ttl_hours": {
        "description": "历史过期时间（小时）",
        "type": "int",
        "default": 0,
        "slider": {
          "min": 0,
          "max": 168,
          "step": 1
        },
        "hint": "最后一次记录消息后，过多久清除该群历史；0 不自动过期。重启清空由下方开关控制。"
      },
      "redis_url": {
        "description": "Redis 地址",
        "type": "string",
        "default": "redis://127.0.0.1:6379/0",
        "hint": "用于保存群聊历史；留空或连接失败时不记录历史，模型也不使用历史。"
      },
      "redis_key_prefix": {
        "description": "Redis 数据前缀",
        "type": "string",
        "default": "juhkff:active_chat",
        "hint": "多个机器人共用 Redis 时请分别设置，避免聊天历史混在一起；一般无需修改。"
      },
      "clear_history_on_start": {
        "description": "重启时清空历史",
        "type": "bool",
        "default": true,
        "hint": "检测到机器人重启或首次使用此前缀时清空历史；普通热重载保留。关闭后仍受过期时间限制。"
      },
      "url_mode": {
        "description": "链接处理方式",
        "type": "string",
        "default": "model",
        "options": [
          "off",
          "model",
          "extract"
        ],
        "labels": [
          "关闭",
          "按需读取",
          "自动提取"
        ],
        "hint": "关闭：不读网页；按需读取：由模型决定，可能增加模型调用；自动提取：预读消息中的前两个链接，即使未接话也可能抓取。"
      },
      "url_content_chars": {
        "description": "网页正文上限（字）",
        "type": "int",
        "default": 400,
        "slider": {
          "min": 100,
          "max": 2000,
          "step": 100
        },
        "hint": "每个网页最多给模型多少字正文，按需读取和自动提取都使用此上限。"
      },
      "persona_prompt": {
        "description": "人设提示词",
        "type": "text",
        "editor_mode": true,
        "editor_language": "markdown",
        "default": "你在一个QQ群聊里，扮演一名普通群员参与聊天。\n只输出一条要发到群里的消息：不要用括号写动作或旁白，不要换行，不要以「回复xx」开头，句尾不加标点；不要解释思路，也不要添加日期、时间戳或发言人标签作为前缀。\n输入消息前的时间（如14:29、11-08 14:29）和发言人标签只是聊天记录的元信息，用于理解上下文，不是回复格式；不要模仿或复述这些前缀。正文中正常谈论时间不受此限制。\n你在群里的昵称是{{botName}}。\n\n请像普通群员那样接着最新这条说一句话，只输出要发的内容本身。\n更早的消息只是聊天背景：不要回复它们，不要续写它们，也不要复述里面的「当时」之类标记。",
        "hint": "设置群聊角色和说话方式；{{botName}} 会替换为机器人昵称。"
      }
    }
  },
  "share_parse": {
    "type": "object",
    "description": "卡片解析",
    "hint": "自动提取分享卡片的标题、简介和链接，可附带封面；不处理普通文字链接。",
    "items": {
      "enable": {
        "description": "启用",
        "type": "bool",
        "default": true
      },
      "parse_bilibili": {
        "description": "解析 B 站分享",
        "type": "bool",
        "default": true
      },
      "parse_xiaoheihe": {
        "description": "解析小黑盒分享",
        "type": "bool",
        "default": true
      },
      "parse_generic": {
        "description": "解析其他分享卡片",
        "type": "bool",
        "default": true,
        "hint": "解析 B 站、小黑盒之外的分享卡片。"
      },
      "fetch_cover": {
        "description": "附带封面图",
        "type": "bool",
        "default": true,
        "hint": "在解析结果中附上封面；未找到封面时只发文字。"
      },
      "cover_timeout": {
        "description": "封面查询超时（秒）",
        "type": "int",
        "default": 8,
        "slider": {
          "min": 1,
          "max": 30,
          "step": 1
        },
        "hint": "查询 B 站封面或解析短链接时，单次请求最多等待多久。"
      },
      "at_sender": {
        "description": "回复时 @ 发送者",
        "type": "bool",
        "default": false,
        "hint": "在解析回复中 @ 分享卡片的人。"
      }
    }
  },
  "emoji_steal": {
    "type": "object",
    "description": "偷表情",
    "hint": "同群相同图片在指定时长内出现两次后收藏，并按概率随机发送表情。",
    "items": {
      "enable": {
        "description": "启用",
        "type": "bool",
        "default": true
      },
      "size_limit_mb": {
        "description": "收藏图片大小上限（MB）",
        "type": "float",
        "default": 2,
        "hint": "超过此大小的群图片不收藏；不限制本地表情包文件夹。",
        "slider": {
          "min": 0.1,
          "max": 10,
          "step": 0.1
        }
      },
      "judge_emoji": {
        "type": "bool",
        "description": "启用表情包判断",
        "default": true,
        "hint": "开启且选择模型后才判断；非表情不收藏，判断失败仍按重复规则收藏。"
      },
      "judge_provider": {
        "type": "string",
        "description": "表情判断模型",
        "default": "",
        "_special": "select_provider",
        "hint": "选择支持图片输入的模型；留空跳过判断，不使用群聊模型。仅在开启表情判断时生效。"
      },
      "max_per_group": {
        "description": "每群收藏上限（张）",
        "type": "int",
        "default": 30,
        "hint": "新增收藏超出上限时，删除最早收藏的图片；不限制本地表情包文件夹。",
        "slider": {
          "min": 10,
          "max": 100,
          "step": 10
        }
      },
      "default_emoji_rate": {
        "description": "默认发图概率",
        "type": "float",
        "default": 0.2,
        "hint": "每条群消息发图的概率，0.2 表示 20%。优先用本群收藏，无可用收藏时用本地文件夹；0 不发图，仍收藏。",
        "slider": {
          "min": 0,
          "max": 1,
          "step": 0.01
        }
      },
      "gallery_path": {
        "description": "本地表情包文件夹",
        "type": "string",
        "default": "",
        "hint": "本群无可用收藏时使用，支持子文件夹；相对路径从插件数据目录算起。留空停用，文件列表缓存 60 秒。"
      },
      "group_rates": {
        "description": "分群发图概率",
        "type": "template_list",
        "default": [],
        "hint": "为指定群单独设置发图概率；未设置的群用默认值，同群多条规则只用第一条。不影响收藏。",
        "templates": {
          "rule": {
            "name": "分群设置",
            "items": {
              "groups": {
                "description": "适用群",
                "type": "list",
                "default": [],
                "_special": "umo",
                "hint": "选择群聊，可多选，也可填写群号；留空则此规则不生效。"
              },
              "emoji_rate": {
                "name": "发图概率",
                "type": "float",
                "default": 0.2,
                "slider": {
                  "min": 0,
                  "max": 1,
                  "step": 0.01
                },
                "description": "发图概率",
                "hint": "这些群的发图概率，0.2 表示 20%；0 不发图，仍收藏。"
              }
            }
          }
        }
      },
      "expire_hours": {
        "description": "重复图片统计时长（小时）",
        "type": "int",
        "default": 72,
        "slider": {
          "min": 0,
          "max": 336,
          "step": 1
        },
        "hint": "同群相同图片从首次计数起，在此时长内第二次出现即收藏，超时重新计数；0 不过期。此设置不清理已收藏图片。"
      }
    }
  },
  "daily_report": {
    "type": "object",
    "description": "日报",
    "hint": "发送 #日报 获取今日日报，包含时政、国内社会、游戏、数码四类新闻，每类最多 12 条。",
    "items": {
      "enable": {
        "description": "启用",
        "type": "bool",
        "default": true
      },
      "style": {
        "description": "日报风格",
        "type": "string",
        "default": "random",
        "options": [
          "random",
          "crosspoint",
          "nightwire",
          "dayletter",
          "dailydrop",
          "greenfolio"
        ],
        "labels": [
          "随机",
          "1 · 红黑索引",
          "2 · 深色电讯",
          "3 · 纸张手帐",
          "4 · 撞色网格",
          "5 · 青绿四栏"
        ],
        "hint": "随机时每次发送随机选一款，也可固定样式；#日报 和定时推送共用此设置。"
      },
      "push": {
        "description": "定时自动推送",
        "type": "bool",
        "default": true,
        "hint": "每天按下方时间自动发送日报；需先选择推送群，关闭后仍可发送 #日报 获取。"
      },
      "push_group_list": {
        "description": "推送群",
        "type": "list",
        "default": [],
        "hint": "选择自动接收日报的群，可多选；留空不自动推送。",
        "_special": "umo"
      },
      "pre_handle": {
        "description": "提前生成",
        "type": "bool",
        "default": false,
        "hint": "按下方时间提前生成日报，减少发送时的等待；随机样式准备五款，固定样式只准备所选款。"
      },
      "push_hour": {
        "description": "推送时间（时）",
        "type": "int",
        "default": 12,
        "slider": {
          "min": 0,
          "max": 23,
          "step": 1
        },
        "hint": "每天推送的小时，使用全局设置中的时区；需开启定时自动推送并选择群。"
      },
      "push_minute": {
        "description": "推送时间（分）",
        "type": "int",
        "default": 0,
        "slider": {
          "min": 0,
          "max": 59,
          "step": 1
        },
        "hint": "与上方小时组成推送时间，例如 12 时 30 分。"
      },
      "pre_handle_hour": {
        "description": "提前生成时间（时）",
        "type": "int",
        "default": 10,
        "slider": {
          "min": 0,
          "max": 23,
          "step": 1
        },
        "hint": "每天几点提前生成日报，建议设在推送之前；仅开启提前生成时生效。"
      },
      "pre_handle_minute": {
        "description": "提前生成时间（分）",
        "type": "int",
        "default": 0,
        "slider": {
          "min": 0,
          "max": 59,
          "step": 1
        },
        "hint": "与上方小时组成提前生成时间，使用全局设置中的时区。"
      },
      "pre_handle_retry_sec": {
        "description": "提前生成重试间隔（秒）",
        "type": "int",
        "default": 120,
        "slider": {
          "min": 30,
          "max": 600,
          "step": 30
        },
        "hint": "提前生成失败后等待多久再试，最多重试 5 次。"
      }
    }
  },
  "pixiv_push": {
    "type": "object",
    "description": "Pixiv 订阅",
    "hint": "订阅画师新插画，将新作和全部图片合并转发。首次订阅或重启 AstrBot 后，首次检查只记录最新作品，不补推旧作。",
    "items": {
      "enable": {
        "description": "启用",
        "type": "bool",
        "default": true
      },
      "subscriptions": {
        "description": "画师订阅列表",
        "type": "template_list",
        "default": [],
        "hint": "每位画师填写一条，并选择接收群；群内订阅指令会同步到这里。留空不检查、不推送。",
        "templates": {
          "artist": {
            "name": "画师订阅",
            "items": {
              "user_id": {
                "description": "画师 UID",
                "type": "string",
                "default": "",
                "hint": "画师主页中的数字用户 ID，不是作品 ID。"
              },
              "groups": {
                "description": "接收群",
                "type": "list",
                "default": [],
                "hint": "选择接收这位画师新作的群，可多选；不选群则此订阅不生效。",
                "_special": "umo"
              }
            }
          }
        }
      },
      "check_minutes": {
        "description": "检查间隔（分钟）",
        "type": "int",
        "default": 60,
        "hint": "正常情况下，每隔多久检查一次画师新作，发现新作后自动推送。",
        "slider": {
          "min": 1,
          "max": 1440,
          "step": 1
        }
      },
      "retry_interval_minutes": {
        "description": "重试基础间隔（分钟）",
        "type": "int",
        "default": 2,
        "hint": "获取作品、下载或发送失败后的首次等待时间。设为 2 时，连续失败依次等 2、4、6…分钟；成功后恢复正常检查。",
        "slider": {
          "min": 1,
          "max": 1440,
          "step": 1
        }
      },
      "max_image_mb": {
        "description": "图片压缩阈值（MB）",
        "type": "float",
        "default": 0.0,
        "hint": "0 表示不压缩；大于 0 时仅压缩超过此大小的图片。始终优先下载原图。",
        "slider": {
          "min": 0,
          "max": 30,
          "step": 0.5
        }
      }
    }
  },
  "help": {
    "type": "object",
    "description": "帮助图",
    "hint": "发送帮助指令，查看本插件已启用功能的用法；默认指令为 #帮助。",
    "items": {
      "enable": {
        "description": "启用",
        "type": "bool",
        "default": true
      },
      "command": {
        "description": "触发指令",
        "type": "string",
        "default": "帮助",
        "hint": "只填指令名称，不加 # 或 /；例如填“帮助”，群里发送 #帮助。"
      },
      "title_zh": {
        "description": "中文标题",
        "type": "string",
        "default": "",
        "hint": "帮助内容的标题；留空使用指令名称，例如“帮助”。"
      },
      "title_en": {
        "description": "英文标题",
        "type": "string",
        "default": "JUHKFF-PLUGIN",
        "hint": "显示在帮助图顶部；留空使用 JUHKFF-PLUGIN。"
      },
      "render_image": {
        "description": "以图片发送帮助",
        "type": "bool",
        "default": true,
        "hint": "开启发送图片，关闭发送文字。"
      }
    }
  }
}
